[Unit]
Description=Nomadic Open WebUI
After=docker.service nomadic-bridge.service
Requires=nomadic-bridge.service
PartOf=nomadic-bridge.service

[Service]
Type=simple
Environment=NOMADIC_WEBUI_IMAGE=ghcr.io/cimbyte/open-webui@sha256:cc55c192c89acb689f2c1faaaef526a61bbb27d9cec8173391b62dad0a286625
EnvironmentFile=%h/.config/nomadic-open-webui/runtime.env
ExecStartPre=-/usr/bin/docker rm -f nomadic-open-webui
ExecStartPre=/usr/bin/docker pull ${NOMADIC_WEBUI_IMAGE}
ExecStart=/usr/bin/docker run --rm --name nomadic-open-webui --network host --read-only --tmpfs /tmp:rw,nosuid,nodev,size=1g --env-file %h/.config/nomadic-open-webui/runtime.env --volume nomadic-open-webui-data:/app/backend/data ${NOMADIC_WEBUI_IMAGE}
ExecStop=/usr/bin/docker stop -t 20 nomadic-open-webui
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
